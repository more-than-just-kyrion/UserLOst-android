<?xml version="1.0" encoding="utf-8"?>
<shortcuts
  xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:icon="@drawable/ic_new_session" android:enabled="true" android:shortcutId="new_session" android:shortcutShortLabel="@string/new_session">
        <intent android:targetPackage="com.termux" android:action="android.intent.action.RUN" android:targetClass="com.termux.app.TermuxActivity" />
    </shortcut>
    <shortcut android:icon="@drawable/ic_new_session" android:enabled="true" android:shortcutId="new_failsafe_session" android:shortcutShortLabel="@string/new_session_failsafe">
        <intent android:targetPackage="com.termux" android:action="android.intent.action.RUN" android:targetClass="com.termux.app.TermuxActivity">
            <extra android:name="com.termux.app.failsafe_session" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
