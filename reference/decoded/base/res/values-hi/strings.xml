    <string name="alert_notification_documents_permission_necessary_message">जारी रखने के लिए, %1$s को %2$s डायरेक्टरी तक पहुंचने की अनुमति दें।</string>
    <string name="alert_notification_permission_necessary_message">जारी रखने के लिए, %1$s को सेवा सूचना पोस्ट करने की अनुमति देने हेतु सूचना अनुमतियां सक्षम करें।</string>
