<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#99d4ff" />
            <stroke android:width="1.0dp" android:color="#a7a7a7" />
            <corners android:radius="3.0dp" />
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#e3e3e3" />
            <stroke android:width="1.0dp" android:color="#585858" />
            <corners android:radius="3.0dp" />
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#e3e3e3" />
            <stroke android:width="1.0dp" android:color="#585858" />
            <corners android:radius="3.0dp" />
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
        </shape>
    </item>
</selector>
