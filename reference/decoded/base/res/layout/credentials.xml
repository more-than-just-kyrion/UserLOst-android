<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textAppearance="@android:style/TextAppearance.Medium" android:id="@android:id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_username" />
    <EditText android:id="@id/editTextUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="text" />
    <TextView android:textAppearance="@android:style/TextAppearance.Medium" android:id="@android:id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_password" />
    <EditText android:id="@id/editTextPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="textPassword" />
    <TextView android:textAppearance="@android:style/TextAppearance.Medium" android:id="@android:id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_domain" />
    <EditText android:id="@id/editTextDomain" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="text" />
</LinearLayout>
