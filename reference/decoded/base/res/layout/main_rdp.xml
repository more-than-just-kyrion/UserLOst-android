                </LinearLayout>
            </TableRow>
            <TableRow>
                <EditText android:textAppearance="?android:textAppearanceMedium" android:id="@id/textUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rdp_username_hint" android:singleLine="true" android:layout_weight="1.0" android:inputType="textVisiblePassword|textNoSuggestions" />
            </TableRow>
            <TableRow>
