            <TableRow>
                <LinearLayout android:orientation="vertical" android:id="@id/sshCredentials" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0">
                    <LinearLayout android:orientation="horizontal" android:padding="0.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true">
                        <EditText android:textAppearance="?android:textAppearanceMedium" android:id="@id/sshUser" android:nextFocusDown="@id/sshPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/username_hint_ssh" android:layout_weight="1.0" android:inputType="textVisiblePassword|textNoSuggestions" />
