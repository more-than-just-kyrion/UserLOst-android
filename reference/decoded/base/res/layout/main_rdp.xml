                    <EditText android:textAppearance="?android:textAppearanceMedium" android:id="@id/sshPort" android:nextFocusDown="@id/sshUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22" android:hint="@string/port_ssh_hint" android:singleLine="true" android:layout_weight="0.0" android:inputType="textVisiblePassword|textNoSuggestions" />
                </LinearLayout>
