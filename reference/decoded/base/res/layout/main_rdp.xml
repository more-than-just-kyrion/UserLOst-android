            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxDesktopBackground" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_desktop_background" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxFontSmoothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_font_smoothing" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxDesktopComposition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_desktop_composition" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxWindowContents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_window_contents" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxMenuAnimation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_menu_animation" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxVisualStyles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_visual_styles" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxEnableGfx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_gfx" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxEnableGfxH264" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_gfxh264" />
            <TextView android:textAppearance="?android:textAppearanceMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/local_device_tweaks" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxUseDpadAsArrows" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dpad_as_arrows" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxRotateDpad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rotate_dpad" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxUseLastPositionToolbar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/position_toolbar_last_used" />
            <TextView android:textAppearance="?android:textAppearanceMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cursor_mode" />
