            <TextView android:textAppearance="?android:textAppearanceMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_advanced_settings" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/layoutAdvancedSettings" android:padding="5.0dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
