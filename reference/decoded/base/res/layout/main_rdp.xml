                <RadioButton android:textAppearance="?android:textAppearanceMedium" android:id="@id/radioRemoteSoundOnServer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remote_sound_on_server" android:onClick="remoteSoundTypeToggled" />
                <RadioButton android:textAppearance="?android:textAppearanceMedium" android:id="@id/radioRemoteSoundOnDevice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remote_sound_on_device" android:onClick="remoteSoundTypeToggled" />
            </RadioGroup>
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxEnableRecording" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enable_recording" android:onClick="toggleEnableRecording" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxConsoleMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_console_mode" />
            <CheckBox android:textAppearance="?android:textAppearanceMedium" android:gravity="left|center" android:id="@id/checkboxRedirectSdCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rdp_adv_redirect_sdcard" />
