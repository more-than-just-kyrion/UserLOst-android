        <Button android:enabled="false" android:id="@id/copy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy" />
        <Button android:enabled="false" android:id="@id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" />
        <TextView android:gravity="left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/prompt_file_will_be_saved" />
        <EditText android:id="@id/file_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="@string/prompt_file_name" android:singleLine="true" android:layout_weight="1.0" android:inputType="text" />
    </TableLayout>
