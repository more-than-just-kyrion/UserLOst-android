<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TableLayout android:orientation="vertical" android:paddingLeft="10.0dp" android:paddingRight="10.0dp" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:enabled="true" android:id="@id/generate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/generate" />
        <Button android:enabled="true" android:id="@id/importKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/key_import" />
        <Button android:enabled="false" android:id="@id/decrypt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/decrypt" />
        <TextView android:gravity="left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/prompt_password_can_be_blank" />
